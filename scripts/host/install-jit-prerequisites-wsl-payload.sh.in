#!/usr/bin/env bash
set -Eeuo pipefail

export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

phase='bootstrap'
tx=''

safe_command() {
  local command="${1//$'\n'/ }"
  local lowered="${command,,}"
  case "${lowered}" in
    *token*|*secret*|*password*|*credential*|*authorization*|*private*key*)
      printf '<redacted>'
      ;;
    *)
      printf '%.240s' "${command}"
      ;;
  esac
}

report_error() {
  local status="$1"
  local line="$2"
  local command
  trap - ERR
  command="$(safe_command "$3")"
  printf 'JIT prerequisite payload failed: phase=%s line=%s exit=%s command=%s\n' \
    "${phase}" "${line}" "${status}" "${command}" >&2
  exit "${status}"
}

cleanup() {
  local status=$?
  trap - ERR EXIT
  set +e
  if [[ -n "${tx}" && -e "${tx}" ]] && ! rm -rf -- "${tx}"; then
    printf 'JIT prerequisite payload cleanup failed: phase=cleanup path=/var/tmp/self-hosted-ci-jit-prereqs.*\n' >&2
    [[ "${status}" -ne 0 ]] && exit "${status}"
    exit 1
  fi
  exit "${status}"
}

die() {
  printf 'JIT prerequisite postcondition failed: phase=%s detail=%s\n' "${phase}" "$1" >&2
  exit 1
}

require_installed_package() {
  local package="$1"
  local status
  if ! status="$(dpkg-query -W -f='${Status}' "${package}" 2>&1)"; then
    die "package ${package} is not queryable"
  fi
  [[ "${status}" == 'install ok installed' ]] || die "package ${package} is not installed"
}

require_command() {
  local command="$1"
  local resolved
  resolved="$(command -v "${command}")" || die "command ${command} is absent from pinned PATH"
  [[ "${resolved}" == /* && -x "${resolved}" ]] || die "command ${command} did not resolve to an executable absolute path"
}

service_property() {
  local unit="$1"
  local property="$2"
  local value
  if ! value="$(systemctl show "${unit}" --property="${property}" --value 2>&1)"; then
    die "cannot inspect ${unit} ${property}"
  fi
  printf '%s' "${value}"
}

require_service_absent() {
  local unit="$1"
  local load_state
  load_state="$(service_property "${unit}" LoadState)"
  [[ "${load_state}" == 'not-found' ]] || die "${unit} remains loaded (${load_state})"
}

make_service_inert() {
  local unit="$1"
  local allow_absent="$2"
  local load_state enabled_state active_state
  load_state="$(service_property "${unit}" LoadState)"
  if [[ "${load_state}" == 'not-found' ]]; then
    [[ "${allow_absent}" == true ]] || die "${unit} is unexpectedly absent"
    return
  fi
  [[ "${load_state}" == 'loaded' ]] || die "${unit} has unsafe load state ${load_state}"
  systemctl stop "${unit}" || die "could not stop ${unit}"
  if enabled_state="$(systemctl is-enabled "${unit}" 2>&1)"; then
    :
  else
    [[ "${enabled_state}" == 'disabled' ]] || die "cannot establish enabled state for ${unit} (${enabled_state})"
  fi
  if [[ "${enabled_state}" != 'disabled' ]]; then
    systemctl disable "${unit}" || die "could not disable ${unit} from ${enabled_state}"
  fi
  if active_state="$(systemctl is-active "${unit}" 2>&1)"; then
    die "${unit} remains active (${active_state})"
  fi
  [[ "${active_state}" == 'inactive' ]] || die "${unit} has unsafe active state ${active_state}"
  if enabled_state="$(systemctl is-enabled "${unit}" 2>&1)"; then
    die "${unit} remains enabled (${enabled_state})"
  fi
  [[ "${enabled_state}" == 'disabled' ]] || die "${unit} has unsafe enabled state ${enabled_state}"
}

trap 'report_error "$?" "$LINENO" "$BASH_COMMAND"' ERR
trap cleanup EXIT

readonly expected_distro='Ubuntu-24.04-CI'
readonly incus_version='@@INCUS_VERSION@@'
readonly garm_version='0.2.1'
readonly garm_sha256='11176acb8a725f914b9b947891b4837d374fb616195562cc0ad45a7be8b6c746'
readonly garm_url='https://github.com/cloudbase/garm/releases/download/v0.2.1/garm-linux-amd64.tgz'
readonly garm_cli_version='0.2.1'
readonly garm_cli_sha256='983fa54557f3f5ce3aa1eeb2387499f5f823d14512a0559ba888667bc3b3e88e'
readonly garm_cli_binary_sha256='a973c9061cf7962b4f90c8220ed6f6cc8abeeed20780ea8b9e31ce6dfc99bd9b'
readonly garm_cli_url='https://github.com/cloudbase/garm/releases/download/v0.2.1/garm-cli-linux-amd64.tgz'
readonly garm_provider_incus_version='0.1.5'
readonly garm_provider_incus_sha256='1489b5f9b3f01528e338c604c13dabe8321ed6f1bc6de77c7344119d7731c43f'
readonly garm_provider_incus_url='https://github.com/cloudbase/garm-provider-incus/releases/download/v0.1.5/garm-provider-incus-linux-amd64.tgz'
tx="$(mktemp -d /var/tmp/self-hosted-ci-jit-prereqs.XXXXXX)"
readonly tx

[[ "${EUID}" -eq 0 ]] || { printf 'payload requires WSL root\n' >&2; exit 1; }
[[ "${WSL_DISTRO_NAME:-}" == "${expected_distro}" ]] || { printf 'unexpected WSL distro\n' >&2; exit 1; }
. /etc/os-release
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 24.04 ]] || { printf 'Ubuntu 24.04 is required\n' >&2; exit 1; }
[[ -d /run/systemd/system ]] || { printf 'systemd is required\n' >&2; exit 1; }
[[ "${incus_version}" =~ ^[0-9A-Za-z][0-9A-Za-z.+~:-]*$ ]] || { printf 'Incus version is not an exact apt version\n' >&2; exit 1; }

# Any pre-existing manager is stopped first. This installer never supplies a
# GARM config, GitHub credential, registration token, pool, or runner.
phase='pre-install-inertness'
make_service_inert garm.service true
make_service_inert self-hosted-ci-garm.service true

phase='apt-installation'
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl dnsmasq-base e2fsprogs nftables squid util-linux "incus=${incus_version}"
# Incus only needs the dnsmasq executable. The full dnsmasq package adds a
# persistent system service and may have been installed by an older revision
# of this bootstrap; remove that wrapper package while retaining dnsmasq-base.
if dpkg-query -W -f='${Status}' dnsmasq 2>/dev/null | grep -Fxq 'install ok installed'; then
  apt-get remove -y dnsmasq
fi
apt-mark hold incus >/dev/null
systemctl daemon-reload

phase='package-postconditions'
[[ "$(dpkg-query -W -f='${Version}' incus)" == "${incus_version}" ]] || die "Incus package version drifted"
for package in e2fsprogs util-linux dnsmasq-base nftables squid; do
  require_installed_package "${package}"
done
for command in dnsmasq nft squid mkfs.ext4 losetup tune2fs findmnt mountpoint truncate systemd-escape blockdev blkid; do
  require_command "${command}"
done
dnsmasq --version >/dev/null || die "dnsmasq executable is not functional"
require_service_absent dnsmasq.service
make_service_inert squid.service false
make_service_inert nftables.service false
grep -qw ext4 /proc/filesystems || { printf 'the WSL kernel does not expose ext4 support\n' >&2; exit 1; }
grep -Eq '(^|[[:space:]])loop([[:space:]]|$)' /proc/devices || { printf 'the WSL kernel does not expose loop devices\n' >&2; exit 1; }
[[ "$(apt-mark showhold incus)" == incus ]] || die "Incus apt hold is absent"

phase='garm-binary-installation'
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --output "${tx}/garm.tgz" "${garm_url}"
printf '%s  %s\n' "${garm_sha256}" "${tx}/garm.tgz" | sha256sum --check --status
[[ "$(tar -tzf "${tx}/garm.tgz")" == garm ]]
tar -xzf "${tx}/garm.tgz" -C "${tx}" --no-same-owner --no-same-permissions
[[ -f "${tx}/garm" && ! -L "${tx}/garm" ]]
install -o root -g root -m 0755 "${tx}/garm" /usr/local/bin/garm
[[ "$(/usr/local/bin/garm --version 2>&1)" == *"${garm_version}"* ]]

curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --output "${tx}/garm-cli.tgz" "${garm_cli_url}"
printf '%s  %s\n' "${garm_cli_sha256}" "${tx}/garm-cli.tgz" | sha256sum --check --status
[[ "$(tar -tzf "${tx}/garm-cli.tgz")" == garm-cli ]]
tar -xzf "${tx}/garm-cli.tgz" -C "${tx}" --no-same-owner --no-same-permissions
[[ -f "${tx}/garm-cli" && ! -L "${tx}/garm-cli" ]]
install -o root -g root -m 0755 "${tx}/garm-cli" /usr/local/bin/garm-cli
[[ "$(stat -c '%U:%G:%a' /usr/local/bin/garm-cli)" == root:root:755 ]]
printf '%s  %s\n' "${garm_cli_binary_sha256}" /usr/local/bin/garm-cli \
  | sha256sum --check --status \
  || die "installed garm-cli binary does not match pinned v${garm_cli_version}"
# `garm-cli version` loads the caller's persistent configuration before it
# prints the local version and therefore is not a safe installation probe.
# Help bypasses that initialization; the exact installed-binary digest above
# establishes the release version while this verifies that the ELF executes.
/usr/local/bin/garm-cli --help >/dev/null \
  || die "installed garm-cli binary is not executable on this host"

curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --output "${tx}/garm-provider-incus.tgz" "${garm_provider_incus_url}"
printf '%s  %s\n' "${garm_provider_incus_sha256}" "${tx}/garm-provider-incus.tgz" | sha256sum --check --status
[[ "$(tar -tzf "${tx}/garm-provider-incus.tgz")" == garm-provider-incus ]]
tar -xzf "${tx}/garm-provider-incus.tgz" -C "${tx}" --no-same-owner --no-same-permissions
[[ -f "${tx}/garm-provider-incus" && ! -L "${tx}/garm-provider-incus" ]]
install -d -o root -g root -m 0755 /usr/local/libexec/garm
install -o root -g root -m 0755 "${tx}/garm-provider-incus" /usr/local/libexec/garm/garm-provider-incus
[[ "$(stat -c '%U:%G:%a' /usr/local/libexec/garm)" == root:root:755 ]]
[[ "$(stat -c '%U:%G:%a' /usr/local/libexec/garm/garm-provider-incus)" == root:root:755 ]]

phase='garm-identity'
if ! id garm-manager >/dev/null 2>&1; then
  useradd --system --create-home --home-dir /var/lib/garm --shell /usr/sbin/nologin garm-manager
fi
if getent group incus-admin >/dev/null \
  && id -nG garm-manager | tr ' ' '\n' | grep -Fxq incus-admin; then
  gpasswd --delete garm-manager incus-admin >/dev/null
fi
passwd --lock garm-manager >/dev/null
if id -nG garm-manager | tr ' ' '\n' | grep -Fxq incus-admin; then
  printf 'garm-manager retains forbidden incus-admin membership\n' >&2
  exit 1
fi
for forbidden in sudo admin wheel; do
  if getent group "${forbidden}" >/dev/null && id -nG garm-manager | tr ' ' '\n' | grep -Fxq "${forbidden}"; then
    printf 'garm-manager is unexpectedly privileged through %s\n' "${forbidden}" >&2
    exit 1
  fi
done

phase='final-inertness'
make_service_inert garm.service true
make_service_inert self-hosted-ci-garm.service true
if pgrep -x garm >/dev/null 2>&1; then
  die "a GARM process remains"
fi
if systemctl list-unit-files --no-legend --type=service --type=socket --type=timer 2>/dev/null \
  | awk 'tolower($1) ~ /garm/ && $2 ~ /^enabled/ { print }' | grep -q .; then
  printf 'an enabled GARM-related unit remains\n' >&2
  exit 1
fi
[[ ! -e /var/lib/garm/.runner && ! -e /var/lib/garm/.credentials ]] || die "persistent runner credentials are present"

phase='complete'
printf '{"status":"installed","distro":"%s","incus_version":"%s","incus_held":true,"dnsmasq_base_installed":true,"dnsmasq_service_absent":true,"nftables_installed":true,"squid_installed":true,"distribution_network_services_disabled":true,"ext4_tools_installed":true,"ext4_kernel_supported":true,"loop_devices_supported":true,"garm_version":"%s","garm_sha256":"%s","garm_cli_version":"%s","garm_cli_sha256":"%s","garm_provider_incus_version":"%s","garm_provider_incus_sha256":"%s","garm_manager_non_admin":true,"garm_manager_incus_admin":false,"garm_enabled":false,"runner_registration_performed":false}\n' \
  "${expected_distro}" "${incus_version}" "${garm_version}" "${garm_sha256}" \
  "${garm_cli_version}" "${garm_cli_sha256}" "${garm_provider_incus_version}" "${garm_provider_incus_sha256}"
