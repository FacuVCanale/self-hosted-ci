{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github-automation.invalid/schemas/gate-results-v1.schema.json",
  "title": "Captured reproducible local gate results v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "captured_at", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "captured_at": { "$ref": "#/$defs/timestamp" },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "command", "cwd", "tool_version", "started_at", "finished_at", "exit_code", "result", "output_path", "output_sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cwd": { "const": "." },
          "tool_version": { "type": "string", "minLength": 1 },
          "started_at": { "$ref": "#/$defs/timestamp" },
          "finished_at": { "$ref": "#/$defs/timestamp" },
          "exit_code": { "type": "integer" },
          "result": { "enum": ["passed", "failed", "findings-triaged"] },
          "output_path": { "type": "string", "pattern": "^evidence/gate-outputs/[a-z0-9-]+\\.txt$" },
          "output_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
