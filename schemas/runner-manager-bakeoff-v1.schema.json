{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github-automation.invalid/schemas/runner-manager-bakeoff-v1.schema.json", "title": "Runner manager bake-off v1",
  "type": "object", "additionalProperties": false, "required": ["runner_bakeoff_schema_version", "selection_policy_version", "evaluated_at", "candidates", "selection"],
  "properties": {
    "runner_bakeoff_schema_version": { "const": 1 }, "selection_policy_version": { "const": 1 }, "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "candidates": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/candidate" } },
    "selection": { "type": "object", "additionalProperties": false, "required": ["result", "candidate_id", "reason", "independent_verifier_signoff"], "properties": {
      "result": { "enum": ["selected", "none-pass"] }, "candidate_id": { "type": ["string", "null"] }, "reason": { "type": "string", "minLength": 1 },
      "independent_verifier_signoff": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/signoff" }] }
    } }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "nonempty": { "type": "string", "minLength": 1 }, "account": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
    "criterion": { "type": "object", "additionalProperties": false, "required": ["id", "class", "status", "evidence_refs", "notes"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "class": { "enum": ["hard_gate", "scoped_capability", "advisory"] }, "status": { "enum": ["pass", "fail", "not_applicable"] }, "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } }, "notes": { "type": "string" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["version", "tag", "image_digest", "evidence_digest", "signature_verified", "sbom_ref", "provenance_ref"], "properties": { "version": { "$ref": "#/$defs/nonempty" }, "tag": { "$ref": "#/$defs/nonempty" }, "image_digest": { "$ref": "#/$defs/digest" }, "evidence_digest": { "$ref": "#/$defs/digest" }, "signature_verified": { "const": true }, "sbom_ref": { "$ref": "#/$defs/nonempty" }, "provenance_ref": { "$ref": "#/$defs/nonempty" } } },
    "maintenance": { "type": "object", "additionalProperties": false, "required": ["archived", "selected_version_supported", "last_release_or_maintenance_at", "unmitigated_critical", "oldest_unmitigated_high_at", "upstream_fixed_pin_available"], "properties": { "archived": { "type": "boolean" }, "selected_version_supported": { "type": "boolean" }, "last_release_or_maintenance_at": { "$ref": "#/$defs/timestamp" }, "unmitigated_critical": { "type": "boolean" }, "oldest_unmitigated_high_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] }, "upstream_fixed_pin_available": { "type": "boolean" } } },
    "rootfulDecision": { "type": "object", "additionalProperties": false, "required": ["decision_id", "approver", "candidate_id", "repositories", "mitigations", "expires_at", "revoked"], "properties": { "decision_id": { "const": "rootful-runner-risk-v1" }, "approver": { "$ref": "#/$defs/account" }, "candidate_id": { "enum": ["fireactions", "garm-incus", "myoung34-docker-github-actions-runner"] }, "repositories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "not": { "pattern": "\\*" } } }, "mitigations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" } }, "expires_at": { "$ref": "#/$defs/timestamp" }, "revoked": { "type": "boolean" } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["candidate_id", "upstream", "selected_artifact", "rootful", "rootful_risk_decision", "maintenance_security", "criteria", "eligible", "scoped_score"], "properties": { "candidate_id": { "enum": ["fireactions", "garm-incus", "myoung34-docker-github-actions-runner"] }, "upstream": { "type": "string", "format": "uri" }, "selected_artifact": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] }, "rootful": { "type": ["boolean", "null"] }, "rootful_risk_decision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rootfulDecision" }] }, "maintenance_security": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/maintenance" }] }, "criteria": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "$ref": "#/$defs/criterion" } }, "eligible": { "type": "boolean" }, "scoped_score": { "type": "integer", "minimum": 0, "maximum": 100 } } },
    "signoff": { "type": "object", "additionalProperties": false, "required": ["verifier", "signed_at", "evidence_digest"], "properties": { "verifier": { "$ref": "#/$defs/nonempty" }, "signed_at": { "$ref": "#/$defs/timestamp" }, "evidence_digest": { "$ref": "#/$defs/digest" } } }
  }
}
