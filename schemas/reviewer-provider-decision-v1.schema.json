{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github-automation.invalid/schemas/reviewer-provider-decision-v1.schema.json",
  "title": "Reviewer provider decision v1",
  "type": "object", "additionalProperties": false,
  "required": ["reviewer_provider_decision_version", "status", "activation_allowed", "provider", "model", "cost_ceilings", "token_ceilings", "timeout_seconds", "retry_policy", "size_limits", "oversized_pr_behavior", "secret_management", "provider_data_terms", "skill_provenance", "approved_by", "approved_at"],
  "properties": {
    "reviewer_provider_decision_version": { "const": 1 }, "status": { "enum": ["BLOCKED", "APPROVED"] }, "activation_allowed": { "type": "boolean" },
    "provider": { "$ref": "#/$defs/nullableNonempty" }, "model": { "$ref": "#/$defs/nullableNonempty" },
    "cost_ceilings": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/costCeilings" }] },
    "token_ceilings": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/tokenCeilings" }] },
    "timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
    "retry_policy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/retryPolicy" }] },
    "size_limits": { "$ref": "#/$defs/sizeLimits" }, "oversized_pr_behavior": { "$ref": "#/$defs/nullableNonempty" },
    "secret_management": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/secretManagement" }] },
    "provider_data_terms": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/providerTerms" }] },
    "skill_provenance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/skillProvenance" }] },
    "approved_by": { "type": ["string", "null"] }, "approved_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] }, "then": { "properties": { "activation_allowed": { "const": false }, "provider": { "type": "null" }, "model": { "type": "null" }, "cost_ceilings": { "type": "null" }, "token_ceilings": { "type": "null" }, "timeout_seconds": { "type": "null" }, "retry_policy": { "type": "null" }, "oversized_pr_behavior": { "type": "null" }, "secret_management": { "type": "null" }, "provider_data_terms": { "type": "null" }, "skill_provenance": { "type": "null" }, "approved_by": { "type": "null" }, "approved_at": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] }, "then": { "properties": { "activation_allowed": { "const": true }, "provider": { "$ref": "#/$defs/nonempty" }, "model": { "$ref": "#/$defs/nonempty" }, "cost_ceilings": { "$ref": "#/$defs/costCeilings" }, "token_ceilings": { "$ref": "#/$defs/tokenCeilings" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 }, "retry_policy": { "$ref": "#/$defs/retryPolicy" }, "oversized_pr_behavior": { "$ref": "#/$defs/nonempty" }, "secret_management": { "$ref": "#/$defs/secretManagement" }, "provider_data_terms": { "$ref": "#/$defs/providerTerms" }, "skill_provenance": { "$ref": "#/$defs/skillProvenance" }, "approved_by": { "$ref": "#/$defs/account" }, "approved_at": { "$ref": "#/$defs/timestamp" } } } }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }, "account": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" }, "nullableNonempty": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonempty" }] }, "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "costCeilings": { "type": "object", "additionalProperties": false, "required": ["per_pr_usd", "monthly_usd"], "properties": { "per_pr_usd": { "type": "number", "exclusiveMinimum": 0 }, "monthly_usd": { "type": "number", "exclusiveMinimum": 0 } } },
    "tokenCeilings": { "type": "object", "additionalProperties": false, "required": ["max_input_tokens", "max_output_tokens"], "properties": { "max_input_tokens": { "type": "integer", "minimum": 1 }, "max_output_tokens": { "type": "integer", "minimum": 1 } } },
    "retryPolicy": { "type": "object", "additionalProperties": false, "required": ["max_attempts", "backoff_seconds"], "properties": { "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 }, "backoff_seconds": { "type": "array", "maxItems": 2, "items": { "type": "integer", "minimum": 1 } } } },
    "sizeLimits": { "type": "object", "additionalProperties": false, "required": ["max_files", "max_diff_bytes", "max_changed_lines"], "properties": { "max_files": { "type": "integer", "minimum": 1, "maximum": 100 }, "max_diff_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "max_changed_lines": { "type": "integer", "minimum": 1, "maximum": 50000 } } },
    "secretManagement": { "type": "object", "additionalProperties": false, "required": ["owner", "storage", "rotation"], "properties": { "owner": { "$ref": "#/$defs/nonempty" }, "storage": { "$ref": "#/$defs/nonempty" }, "rotation": { "$ref": "#/$defs/nonempty" } } },
    "providerTerms": { "type": "object", "additionalProperties": false, "required": ["retention", "residency"], "properties": { "retention": { "$ref": "#/$defs/nonempty" }, "residency": { "$ref": "#/$defs/nonempty" } } },
    "skillProvenance": { "type": "object", "additionalProperties": false, "required": ["source_url", "source_commit", "sha256", "policy_version"], "properties": { "source_url": { "type": "string", "format": "uri" }, "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "policy_version": { "$ref": "#/$defs/nonempty" } } }
  }
}
