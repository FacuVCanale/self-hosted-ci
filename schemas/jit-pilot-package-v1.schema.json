{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://self-hosted-ci.invalid/schemas/jit-pilot-package-v1.schema.json","title":"Non-gating JIT pilot package v1","type":"object","additionalProperties":false,"required":["jit_pilot_package_version","repository","repository_id","pr_number","base_branch","base_sha","head_sha","tested_merge_sha","workflow_ref","backend","allocation_id","runner_label","issued_at","expires_at"],"properties":{"jit_pilot_package_version":{"const":1},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"repository_id":{"type":"integer","minimum":1},"pr_number":{"type":"integer","minimum":1},"base_branch":{"type":"string","minLength":1,"maxLength":255},"base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tested_merge_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"workflow_ref":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/ci-jit-pilot-child\\.yml@refs/heads/[A-Za-z0-9._/-]+$"},"backend":{"enum":["local","github"]},"allocation_id":{"type":["string","null"]},"runner_label":{"type":["string","null"]},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"backend":{"const":"local"}}},"then":{"properties":{"allocation_id":{"type":"string","format":"uuid"},"runner_label":{"type":"string","pattern":"^wsl-jit-[0-9a-f]{32}$"}}},"else":{"properties":{"allocation_id":{"type":"null"},"runner_label":{"type":"null"}}}}]}
