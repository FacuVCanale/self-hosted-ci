{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github-automation.invalid/schemas/scenario-proof-records-v1.schema.json",
  "title": "Scenario-to-test proof records v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "matrix_sha256", "gate_results_sha256", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "matrix_sha256": { "$ref": "#/$defs/sha256" },
    "gate_results_sha256": { "$ref": "#/$defs/sha256" },
    "records": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "selector", "result", "gate_id", "gate_output_sha256", "evidence"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^S(?:0[1-9]|[1-9][0-9]|10[0-8])$" },
          "selector": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^tests\\.github_automation\\.test_[A-Za-z0-9_]+\\.test_[A-Za-z0-9_]+$" } },
          "result": { "const": "passed" },
          "gate_id": { "const": "github-automation-tests" },
          "gate_output_sha256": { "$ref": "#/$defs/sha256" },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
            }
          }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
