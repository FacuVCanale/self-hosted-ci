{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FacuVCanale/self-hosted-ci/schemas/runner-allocation-v2.schema.json",
  "title": "Signed disposable runner allocation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signer_fingerprint", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_allocation_version", "allocation_id", "repository_id", "repository", "pr_number", "head_sha", "base_sha", "tested_sha", "dispatch_sha", "workflow_ref", "run_id", "run_attempt", "job_id", "job_name", "authority_kind", "runner_group", "scale_set_name", "labels", "image_fingerprint", "nonce", "approval_issued_at", "approval_expires_at", "issued_at", "claim_deadline", "max_jobs", "ephemeral"],
      "properties": {
        "runner_allocation_version": {"const": 2},
        "allocation_id": {"type": "string", "format": "uuid"},
        "repository_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pr_number": {"type": "integer", "minimum": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dispatch_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workflow_ref": {"type": "string"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "job_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "job_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "authority_kind": {"enum": ["personal-repository", "organization-runner-group"]},
        "runner_group": {"type": ["string", "null"]},
        "scale_set_name": {"type": "string", "pattern": "^wsl-jit-[0-9a-f]{32}$"},
        "labels": {"type": "array", "minItems": 1, "maxItems": 1},
        "image_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "approval_issued_at": {"type": "string", "format": "date-time"},
        "approval_expires_at": {"type": "string", "format": "date-time"},
        "issued_at": {"type": "string", "format": "date-time"},
        "claim_deadline": {"type": "string", "format": "date-time"},
        "max_jobs": {"const": 1},
        "ephemeral": {"const": true}
      }
    },
    "signer_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
