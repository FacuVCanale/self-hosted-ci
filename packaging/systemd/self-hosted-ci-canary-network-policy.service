[Unit]
Description=Temporary authorized network policy for the JIT canary lane
Requires=self-hosted-ci-network-quarantine.service
After=self-hosted-ci-network-quarantine.service
Before=self-hosted-ci-canary-egress-proxy.service self-hosted-ci-canary-garm.service
ConditionPathExists=/run/self-hosted-ci/CANARY_APPROVED
Conflicts=self-hosted-ci-network-policy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/lib/self-hosted-ci/run-wsl-jit-canary-matrix.py verify
ExecStart=/usr/local/lib/self-hosted-ci/apply-runner-network-policy.sh apply
ExecStartPost=/usr/local/lib/self-hosted-ci/apply-runner-network-policy.sh verify
ExecStop=/usr/local/lib/self-hosted-ci/apply-runner-network-policy.sh quarantine
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
