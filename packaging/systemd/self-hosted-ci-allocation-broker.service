[Unit]
Description=Transient allocation broker for self-hosted-ci GARM runners
Requires=self-hosted-ci-garm.service self-hosted-ci-network-policy.service
After=self-hosted-ci-garm.service self-hosted-ci-network-policy.service
ConditionPathExists=/etc/self-hosted-ci/ACTIVATION_APPROVED

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/bin/sh -c 'i=0; until /usr/local/lib/self-hosted-ci/garm-cli-session.py ensure >/dev/null 2>&1 && /usr/local/lib/self-hosted-ci/garm-allocation-broker.py recover >/dev/null 2>&1; do i=$((i+1)); [ "$i" -lt 60 ] || exit 1; sleep 1; done'
ExecStart=/usr/local/lib/self-hosted-ci/garm-allocation-broker.py serve
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/self-hosted-ci/garm /run/self-hosted-ci
Environment=INCUS_CONF=/run/self-hosted-ci/incus-client
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
UMask=0077
RuntimeDirectory=self-hosted-ci
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
