[Unit]
Description=Temporary allocation broker for the JIT canary lane
Requires=self-hosted-ci-canary-garm.service self-hosted-ci-canary-network-policy.service
After=self-hosted-ci-canary-garm.service self-hosted-ci-canary-network-policy.service
ConditionPathExists=/run/self-hosted-ci/CANARY_APPROVED
Conflicts=self-hosted-ci-allocation-broker.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/usr/local/lib/self-hosted-ci/run-wsl-jit-canary-matrix.py verify
ExecStartPre=/bin/sh -c 'i=0; until /usr/bin/python3 -c '\''import socket; connection=socket.create_connection(("127.0.0.1",9997),timeout=.25); connection.close()'\''; do i=$((i+1)); [ "$i" -lt 240 ] || exit 1; sleep .25; done'
ExecStart=/usr/local/lib/self-hosted-ci/garm-allocation-broker.py serve
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/self-hosted-ci/garm /var/lib/self-hosted-ci/canary /run/self-hosted-ci
Environment=INCUS_CONF=/run/self-hosted-ci/incus-client
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
UMask=0077
