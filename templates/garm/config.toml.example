# INERT GARM 0.2.1 TEMPLATE. configure-garm-jit.sh renders both placeholders
# from root-only secret files before activation and validates the separately
# installed Incus provider configuration.
[default]
enable_webhook_management = false

[logging]
enable_log_streamer = false
log_format = "json"
log_level = "info"
log_source = false

[metrics]
enable = false
disable_auth = false

[apiserver]
bind = "127.0.0.1"
port = 9997
use_tls = false
cors_origins = []

[apiserver.webui]
enable = false

[jwt_auth]
secret = "REPLACE_ME_WITH_32_CHARS________"
time_to_live = "24h"

[database]
backend = "sqlite3"
passphrase = "REPLACE_ME_WITH_32_CHARS________"

[database.sqlite3]
db_file = "/var/lib/self-hosted-ci/garm/garm.db"
busy_timeout_seconds = 5

[[provider]]
name = "incus_ci_jit"
provider_type = "external"
description = "Pinned local Incus provider"
disable_jit_config = false

[provider.external]
provider_executable = "/usr/local/libexec/garm/garm-provider-incus"
config_file = "/etc/self-hosted-ci/garm/garm-provider-incus.toml"
environment_variables = []
exec_timeout_seconds = 120

# GitHub credentials, provider TLS keys, endpoints, scalesets and runner tokens
# are rendered only after their independent activation gates pass.
